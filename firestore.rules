rules_version = '2';

// One profile document per signed-in user (anonymous or Google-linked — see
// src/firebase/auth.ts and docs/firebase.md). A user may only read/write their own
// document; nothing else is stored in this project's Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // AI-generated category content (functions/src/index.ts) — public, read-only.
    // Every document here already passed the same solver-verified acceptance every
    // hand-authored level does (see functions/src/index.ts's verifySolvable), so
    // any signed-in player (including anonymous — everyone gets one, see
    // src/firebase/auth.ts) may read it. Only Cloud Functions (Admin SDK, which
    // bypasses these rules entirely) may write it — no client, however
    // authenticated, ever writes here.
    match /aiCategories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // AI-generated levels (functions/src/index.ts's generateLevelNow) — same
    // public-read/Cloud-Functions-only-write shape as aiCategories above. A
    // level is only readable once it's fully generated and written (status
    // "ready" — see generateLevelNow).
    match /levels/{levelId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // "Report an unsolvable level" flags (functions/src/index.ts's
    // reportUnsolvableLevel) — written only by that Cloud Function (Admin SDK
    // bypasses these rules); the client submits a report through the callable,
    // never by writing here directly, and has no reason to read it either.
    match /levelReportFlags/{levelId} {
      allow read, write: if false;
    }

    // "A player registered" dedup flags (functions/src/index.ts's
    // notifyUserRegistered) — same Cloud-Functions-only shape as the collections
    // above; no client ever reads or writes this directly.
    match /userRegisteredFlags/{uid} {
      allow read, write: if false;
    }
  }
}
