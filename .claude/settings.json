{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "git push 2>&1 || true",
            "if": "Bash(git commit:*)",
            "statusMessage": "Auto-pushing to remote",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
