# Copy to .env.local and fill in your own Firebase project's values
# (Project settings -> General -> Your apps -> SDK setup and configuration)
# to enable Phase 5 cloud sync. The app runs perfectly well without this file —
# it falls back to local-only storage (src/store/playerStore.ts) when unset.
# See docs/firebase.md for the intended auth/sync design.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
